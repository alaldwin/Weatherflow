# OpenWeather API configuration
OPENWEATHER_API_KEY=your_openweather_api_key


# Local PostgreSQL configuration (used by `docker compose up -d db` and local runs)
POSTGRES_HOST=localhost

POSTGRES_PORT=port

POSTGRES_DB=weatherflow

POSTGRES_USER=weatherflow

POSTGRES_PASSWORD=weatherflow

# Optional: how the loader treats an existing table ("replace", "append" or "fail")
# POSTGRES_IF_EXISTS=replace